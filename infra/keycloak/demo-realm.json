{
  "realm": "demo",
  "enabled": true,
  "displayName": "Legacy AI Bridge Demo (模擬公司 SSO)",
  "accessTokenLifespan": 900,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "cs_agent",
        "description": "客服人員：只能處理指派給自己的工單，單筆補償上限 100 元"
      },
      {
        "name": "cs_supervisor",
        "description": "客服主管：可看全部工單，單筆補償上限 500 元，簽核補償申請"
      },
      {
        "name": "logistics_staff",
        "description": "物流人員：審核並執行改寄申請"
      },
      {
        "name": "sre",
        "description": "維運人員（預留給 M6 AIOps）"
      }
    ]
  },
  "clients": [
    {
      "clientId": "copilot-web",
      "name": "Copilot Web (Vue)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "aud-copilot-agent",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "copilot-agent",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "order-web",
